{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页",
				"disableScroll": true
			}
		},
		{
			"path": "pages/my/recycle",
			"style": { "navigationBarTitleText": "转盘回收站" }
		},
		{
			"path": "pages/my/index",
			"style": {
				"navigationBarTitleText": "my"
			}
		},
		{
			"path": "pages/function/index",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/list/index",
			"style": {
				"navigationBarTitleText": "列表"
			}
		}
	],
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"subPackages": [
		{
			"root": "pagesClicker",
			"pages": [
				{ "path": "index", "style": { "navigationBarTitleText": "连点器" } }
			]
		},
		{
			"root": "pagesCompress",
			"pages": [
				{ "path": "index", "style": { "navigationBarTitleText": "图片压缩" } },
				{ "path": "video", "style": { "navigationBarTitleText": "视频压缩" } }
			]
		},
		{
			"root": "pagesWatermark",
			"pages": [
				{
					"path": "index",
					"style": { "navigationBarTitleText": "图片去水印" }
				}
			]
		},
		{
			"root": "pagesWheel",
			"pages": [
				{
					"path": "wheelEdit/index",
					"style": {
						"navigationBarTitleText": "编辑"
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#0a213d",
		"backgroundColor": "#0a213d"
	}
}
